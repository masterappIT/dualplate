<?xml version="1.0" encoding="utf-8"?>
<!-- 啟動時的視窗底：深綠，正中白色 MasterApp 標誌 100×76dp（照現有 App android/app/client/src/main/res/drawable-v23/launch_background.xml）。
     與 Android 12 起的系統啟動畫面（drawable-v31/launch_icon.xml）、Flutter 的啟動畫面（lib/shell/launch_view.dart LaunchCover）同尺寸同位置。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_jade" />
    <item
        android:width="100dp"
        android:height="76dp"
        android:gravity="center"
        android:drawable="@drawable/launch_mark" />
</layer-list>
