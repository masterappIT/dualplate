<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 深色模式同樣用淺色外觀（現有 App DCLOUD_DARK_MODE=light）。桌面圖示點開後到 Flutter 畫出第一幀之前：深綠啟動圖，狀態列和導航列也是深綠（照現有 App 的 DualplateEntryTheme） -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_jade</item>
        <item name="android:statusBarColor">@color/launch_jade</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
    <!-- Flutter 畫面後面的視窗底：同一張深綠啟動圖（照現有 App 的 DualplateTheme） -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_jade</item>
        <item name="android:statusBarColor">@color/launch_jade</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
