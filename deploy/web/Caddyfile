    email {$CADDY_EMAIL}
}

{$ADMIN_DOMAIN} {
    encode zstd gzip
    header X-Robots-Tag "noindex, nofollow"
    header Content-Security-Policy "frame-ancestors 'none'"
    header /api/* Cache-Control "no-store"
    request_body {
        max_size 15MB
    }
    handle /api/* {
        reverse_proxy api:4100
    }
    handle /assets/* {
        root * /srv/admin
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/admin
        try_files {path} /index.html
        header Cache-Control "no-store"
        file_server
    }
}

{$MOBILE_DOMAIN} {
    encode zstd gzip
    header /api/* Cache-Control "no-store"
    request_body {
        max_size 15MB
    }
    handle /api/* {
        reverse_proxy api:4100
    }
    handle /r/* {
        reverse_proxy api:4100
    }
    handle /assets/* {
        root * /srv/mobile
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/mobile
        try_files {path} /index.html
        header Cache-Control "no-store"
        file_server
    }
}
