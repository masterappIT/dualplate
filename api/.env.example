# API 伺服器環境變數（範例，不含真實值）。複製為 .env 後填寫；.env 不提交。
PORT=4100
# SQLite 資料庫檔案位置；正式環境放在備份範圍內的資料夾
DB_PATH=/srv/plate-crm/data/app.sqlite
# 允許呼叫 API 的前端網址（管理端、客戶端 H5），逗號分隔
CORS_ORIGINS=https://admin.example.com,https://m.example.com
# 每日備份輸出資料夾與保留天數
BACKUP_DIR=/srv/plate-crm/backups
BACKUP_KEEP_DAYS=30
# 錯誤記錄資料夾（按日一個檔）
LOG_DIR=/srv/plate-crm/logs
# 業務時區（到期日計算）；預設香港
BUSINESS_TZ=Asia/Hong_Kong
# 微信小程序登入；未設定時微信登入接口回 503，小程序只顯示帳號密碼登入
WECHAT_APPID=
WECHAT_SECRET=
# 只在本機示範時設為 1，正式環境不要設定
DEMO_SEED=0
