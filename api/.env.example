# API 伺服器環境變數範例；正式環境由 Secret Manager 產生 /srv/dualplate/app.env。
PORT=4100
# SQLite 資料庫檔案位置；正式環境放在備份範圍內的資料夾
DB_PATH=/srv/dualplate/data/app.sqlite
# 正式環境同站 /api；留空即可。若日後跨站呼叫，再填逗號分隔的來源網址。
CORS_ORIGINS=
# 每日備份輸出資料夾與保留天數
BACKUP_DIR=/srv/dualplate/backups
BACKUP_KEEP_DAYS=90
# 錯誤記錄資料夾（按日一個檔）
LOG_DIR=/srv/dualplate/logs
# 承租方專屬連結形如 https://dualplate.masterappinc.com/r/<令牌>
PUBLIC_BASE_URL=https://dualplate.masterappinc.com
# 業務時區（到期日計算）；預設香港
BUSINESS_TZ=Asia/Hong_Kong
# 微信小程序登入；未設定時微信登入接口回 503，小程序只顯示帳號密碼登入
WECHAT_APPID=
WECHAT_SECRET=
# 只在本機示範時設為 1，正式環境不要設定
DEMO_SEED=0
