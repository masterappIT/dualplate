<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 起的系統啟動畫面圖示：深綠底，正中白色 MasterApp 標誌（M 雲）。
     系統把 108dp 畫布顯示為 288dp（Android 17 模擬器實測）；四邊按比例留空，標誌顯示為 100×76dp，與視窗底、DCloud 啟動圖同尺寸。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_jade" />
    <foreground>
        <inset
            android:drawable="@drawable/launch_mark"
            android:insetLeft="32.64%"
            android:insetRight="32.64%"
            android:insetTop="36.81%"
            android:insetBottom="36.81%" />
    </foreground>
</adaptive-icon>
