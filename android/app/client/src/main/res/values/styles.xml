<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="DCloudActivityTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorEdgeEffect">#333333</item>
        <item name="android:windowBackground">@color/ime_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- 桌面圖示點開後的入口頁：不透明，一開就是深綠啟動圖，取代 DCloud 範例的透明入口 -->
    <style name="DualplateEntryTheme" parent="@style/TranslucentTheme">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_jade</item>
        <item name="android:statusBarColor">@color/launch_jade</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!-- DCloud 主頁面：啟動期間的視窗底同樣是深綠啟動圖，避免出現 DCloud 預設的灰色 -->
    <style name="DualplateTheme" parent="@style/DCloudTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_jade</item>
        <item name="android:statusBarColor">@color/launch_jade</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>
